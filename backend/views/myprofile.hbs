<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" type="text/css" href="/main.css" />
    <title>My Profile</title>
</head>
<body>
    {{> header title="My Profile"}}
    
    <article>
        <div class="comment">
            <p class="username" style="color: {{color}}">{{name}}</p>
            <p>({{username}})</p>
        </div>
        <a href="/myprofile/chdisplay">Change Display Name</a>
        <a href="/myprofile/chpass">Change Password</a>
        <a href="/myprofile/chcolor">Change Color</a>
    </article>
    
    {{> footer}}
</body>
</html>