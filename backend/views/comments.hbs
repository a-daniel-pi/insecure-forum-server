<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" type="text/css" href="/main.css" />
    <title>Comments</title>
</head>
<body>
    {{> header title="Comments"}}
    
    <article>
        <a href="/comments/new">Make a New Comment</a>
        {{#unless comments}}
            <p>No comments on this page. </p>
        {{/unless}}
        {{#each comments}}
            {{> comment name=username content=content created=created_at}}
        {{/each}}
        {{#if prev}}
            <a href="/comments?page={{prev}}">Previous Page</a>
        {{/if}}
        {{#if hasNext}}
            <a href="/comments?page={{next}}" class="next">Next Page</a>
        {{/if}}
    </article>
    
    {{> footer}}
</body>
</html>